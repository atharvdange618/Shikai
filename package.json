{
  "name": "shikai",
  "description": "A read-only GitHub dashboard for Android. Browse repos, contribution graphs, stars, and activity.",
  "version": "1.8.0",
  "author": "Atharv Dange (https://x.com/atharvdangedev)",
  "license": "MIT",
  "homepage": "https://github.com/atharvdange618/Shikai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/atharvdange618/Shikai.git"
  },
  "bugs": {
    "url": "https://github.com/atharvdange618/Shikai/issues"
  },
  "keywords": [
    "github",
    "dashboard",
    "react-native",
    "expo",
    "android",
    "open-source"
  ],
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "deploy": "npx expo export -p web && wrangler deploy",
    "preview": "npx expo export -p web && wrangler dev",
    "prebuild:clean": "npx expo prebuild --clean",
    "android:assemble": "cd android && set SENTRY_DISABLE_AUTO_UPLOAD=true&& gradlew.bat assembleRelease",
    "android:bundle": "cd android && gradlew.bat bundleRelease",
    "sentry:sourcemaps": "sentry-expo-upload-sourcemaps dist"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "^12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/highlight": "^1.2.0",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/query-core": "^5.101.2",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "axios": "^1.20.0",
    "expo": "~57.0.31",
    "expo-auth-session": "~57.0.16",
    "expo-background-task": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-in-app-updates": "^0.12.0",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-share-intent": "^8.0.1",
    "expo-splash-screen": "~57.0.10",
    "expo-store-review": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-android-widget": "^0.20.3",
    "react-native-blob-util": "^0.24.10",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-pdf": "^7.0.5",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "^0.10.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.88.0"
  },
  "private": true,
  "allowScripts": {
    "@sentry/cli@2.55.0": true,
    "@sentry/cli@2.58.4": true,
    "browser-tabs-lock@1.3.0": true,
    "core-js@2.6.12": true,
    "core-js@3.47.0": true,
    "esbuild@0.27.3": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260504.1": true,
    "workerd@1.20260617.1": true,
    "workerd@1.20261023.1": true,
    "bufferutil@4.1.0": true,
    "utf-8-validate@6.0.6": true
  }
}
