{
  "name": "shikai",
  "description": "A read-only GitHub dashboard for Android. Browse repos, contribution graphs, stars, and activity.",
  "version": "1.9.0",
  "author": "Atharv Dange (https://x.com/atharvdangedev)",
  "license": "MIT",
  "homepage": "https://github.com/atharvdange618/Shikai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/atharvdange618/Shikai.git"
  },
  "bugs": {
    "url": "https://github.com/atharvdange618/Shikai/issues"
  },
  "keywords": [
    "github",
    "dashboard",
    "react-native",
    "expo",
    "android",
    "open-source"
  ],
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "oxlint .",
    "test": "vitest run",
    "deploy": "npx expo export -p web && wrangler deploy",
    "preview": "npx expo export -p web && wrangler dev",
    "prebuild:clean": "npx expo prebuild --clean",
    "android:assemble": "cd android && SENTRY_DISABLE_AUTO_UPLOAD=true ./gradlew assembleRelease",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "sentry:sourcemaps": "sentry-expo-upload-sourcemaps dist",
    "commit": "cz",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "oxlint . --fix",
    "lint:strict": "oxlint . --deny-warnings",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "^12.0.1",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/highlight": "^1.2.0",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/query-core": "^5.101.2",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "axios": "^1.20.0",
    "expo": "~58.0.22",
    "expo-auth-session": "~58.0.16",
    "expo-background-task": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-in-app-updates": "^0.12.0",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-share-intent": "^9.0.0",
    "expo-splash-screen": "~58.0.12",
    "expo-store-review": "~58.0.2",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-updates": "~58.0.20",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-android-widget": "^0.20.3",
    "react-native-blob-util": "^0.24.10",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-pdf": "^7.0.5",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.13.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.88.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.10"
  },
  "private": true,
  "overrides": {
    "react-native": "0.88.1"
  },
  "allowScripts": {
    "@sentry/cli@2.55.0": true,
    "@sentry/cli@2.58.4": true,
    "browser-tabs-lock@1.3.0": true,
    "core-js@2.6.12": true,
    "core-js@3.47.0": true,
    "esbuild@0.27.3": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260504.1": true,
    "workerd@1.20260617.1": true,
    "workerd@1.20261023.1": true,
    "bufferutil@4.1.0": true,
    "utf-8-validate@6.0.6": true,
    "@sentry/cli@3.8.0": true,
    "@sentry/cli@2.58.6": true,
    "workerd@1.20261102.1": true
  },
  "lint-staged": {
    "*.{json,md,css}": [
      "prettier --write"
    ],
    "*.{js,jsx,cjs,mjs,ts,tsx}": [
      "oxlint --fix",
      "oxlint",
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
