{
  "name": "shikai",
  "description": "A read-only GitHub dashboard for Android. Browse repos, contribution graphs, stars, and activity.",
  "version": "1.3.0",
  "author": "Atharv Dange (https://x.com/atharvdangedev)",
  "license": "MIT",
  "homepage": "https://github.com/atharvdange618/Shikai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/atharvdange618/Shikai.git"
  },
  "bugs": {
    "url": "https://github.com/atharvdange618/Shikai/issues"
  },
  "keywords": [
    "github",
    "dashboard",
    "react-native",
    "expo",
    "android",
    "open-source"
  ],
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "deploy": "npx expo export -p web && wrangler deploy",
    "preview": "npx expo export -p web && wrangler dev",
    "prebuild:clean": "npx expo prebuild --clean && node scripts/post-prebuild.js",
    "android:assemble": "cd android && gradlew.bat assembleRelease",
    "android:bundle": "cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/query-core": "^5.101.2",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "axios": "^1.15.0",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.20.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2",
    "wrangler": "^4.88.0"
  },
  "overrides": {
    "react-native": "0.81.5"
  },
  "private": true,
  "allowScripts": {
