{
  "name": "shikai",
  "description": "A read-only GitHub dashboard for Android. Browse repos, contribution graphs, stars, and activity.",
  "version": "1.8.0",
  "author": "Atharv Dange (https://x.com/atharvdangedev)",
  "license": "MIT",
  "homepage": "https://github.com/atharvdange618/Shikai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/atharvdange618/Shikai.git"
  },
  "bugs": {
    "url": "https://github.com/atharvdange618/Shikai/issues"
  },
  "keywords": [
    "github",
    "dashboard",
    "react-native",
    "expo",
    "android",
    "open-source"
  ],
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "deploy": "npx expo export -p web && wrangler deploy",
    "preview": "npx expo export -p web && wrangler dev",
    "prebuild:clean": "npx expo prebuild --clean",
    "android:assemble": "cd android && set SENTRY_DISABLE_AUTO_UPLOAD=true&& gradlew.bat assembleRelease",
    "android:bundle": "cd android && gradlew.bat bundleRelease",
    "sentry:sourcemaps": "sentry-expo-upload-sourcemaps dist"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/highlight": "^1.2.0",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/query-core": "^5.101.2",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "axios": "^1.20.0",
    "expo": "~55.0.32",
    "expo-auth-session": "~55.0.19",
    "expo-background-task": "~55.0.22",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-in-app-updates": "^0.12.0",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-share-intent": "^6.1.1",
    "expo-splash-screen": "~55.0.25",
    "expo-store-review": "~55.0.18",
    "expo-system-ui": "~55.0.22",
    "expo-task-manager": "~55.0.20",
    "expo-updates": "~55.0.33",
    "expo-video": "~55.0.21",
    "expo-web-browser": "~55.0.20",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "^0.83.10",
    "react-native-android-widget": "^0.20.3",
    "react-native-blob-util": "^0.24.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-pdf": "^7.0.5",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "^0.7.4",
    "zustand": "^5.0.12"
  },
