# Copy to .env and fill in. All EXPO_PUBLIC_* vars are inlined into the
# app bundle at build time, so treat them as public.

# GitHub OAuth app (https://github.com/settings/apps)
EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_GITHUB_APP_SLUG=
EXPO_PUBLIC_OAUTH_PROXY_URL=

# Sentry DSN (Settings > Projects > shikai > Client Keys). Safe to expose,
# but kept here so it isn't committed to the public repo. Leave blank to
# disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=

NODE_ENV=production

# --- Build-time only, do NOT prefix with EXPO_PUBLIC_ ---
# Sentry auth token for source map upload. Real secret. The wizard writes
# this to .env.local (gitignored). Needed for `eas build` and the OTA
# source map step, not for running the app.
# SENTRY_AUTH_TOKEN=
